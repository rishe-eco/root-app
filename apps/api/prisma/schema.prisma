// Root website — data model.
//
// Role-aware from day one (customer / admin). Per the v3 overview §4 this is
// the decision that makes deferring the admin UI safe: breaking changes come
// from a single-role data model, not from a missing screen.
//
// Postgres (decided, v3 §3) — a multi-customer portal with concurrent logins
// and uploads wants it, and Prisma keeps the engine a config detail.

generator client {
  provider = "prisma-client-js"

  // "native" alone was a silent single point of failure. Prisma picks the
  // engine by probing the build machine for libssl, and when the probe fails
  // it does not error — it defaults to debian-openssl-1.1.x and carries on.
  // The container that comes out is fine until its first query.
  //
  // Naming the production target makes that impossible: the engine the VPS
  // needs is fetched because it was asked for, not because a probe happened to
  // work. "native" stays first so a dev machine — any OS — still gets its own,
  // and on a correctly built image the two are the same file.
  //
  // This is belt and braces with apps/api/Dockerfile, which installs openssl
  // so the probe works and then asserts the engine exists. Both, deliberately:
  // the failure was invisible, cost a live deployment, and the two guards fail
  // in different ways.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// People & access
// ---------------------------------------------------------------------------

/// A person holds a *set* of these, never one (build plan F3). The set exists
/// because the three surfaces arrived wanting different people: the Library
/// wants a contributor, the Review Room wants a reviewer, and some hold both.
///
/// A role is never tested directly outside `lib/capabilities.ts` — it is an
/// input to the capability table and nothing else. Testing a role works right
/// up until someone holds two, and then every `===` silently inverts.
enum Role {
  /// Object-scoped only: their own contract, once published. Maps to the empty
  /// capability set, which is not a demotion — see lib/capabilities.ts.
  CUSTOMER
  ADMIN
  /// Writes Library entries. Deliberately *not* implied by REVIEWER.
  CONTRIBUTOR
  /// The Review Room and nothing else. This is the one role handed to someone
  /// outside Root, so it is the one that has to stay least-privilege.
  REVIEWER
  /// Build plan D6, 2026-09-20: the person who authors a build has no other
  /// role to be. Grants `builds.author` alone — not `contracts.manage`, not
  /// `customers.manage`, not `apiTokens.manage` — so a contractor ticking
  /// feedback off a queue never sees the contract text, the fee, the customer
  /// list or the billing surface. See lib/capabilities.ts.
  DEVELOPER
}

enum UserState {
  INVITED // invite issued, password not yet set
  ACTIVE
  DISABLED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  /// Non-empty, enforced by a CHECK constraint in the migration — Prisma
  /// cannot express it, and a user with no roles is one no capability check
  /// can ever admit.
  roles        Role[]    @default([CUSTOMER])
  state        UserState @default(INVITED)
  passwordHash String?

  // Company/brand this customer belongs to, shown as the sub-line in the
  // contracts table. Null for admins.
  clientName String?

  // Preferred locale, so notifications can go out in the right language.
  locale String @default("fa")

  contracts             Contract[]      @relation("CustomerContracts")
  projects              Project[]       @relation("CustomerProjects")
  scopeTrades           ScopeTrade[]
  comments              Comment[]
  changeLogs            ChangeLog[]
  signatures            Signature[]
  tokens                AuthToken[]
  apiTokens             ApiToken[]
  billingEntry          BillingEntry[]
  /// Build plan L6 — see Subscription's own comment.
  subscriptions         Subscription[]  @relation("SubscriptionCustomer")
  /// Build plan L7 — the product-import panel's run history.
  serviceRunsUploaded   ServiceRun[]    @relation("ServiceRunUploadedBy")
  serviceRunsApplied    ServiceRun[]    @relation("ServiceRunAppliedBy")
  tickets               Ticket[]
  ticketMessage         TicketMessage[]
  uploads               StoredFile[]
  libraryEntries        LibraryEntry[]
  reviewRounds          ReviewRound[]
  reviewThreadsOpened   ReviewThread[]  @relation("ThreadAuthor")
  reviewThreadsResolved ReviewThread[]  @relation("ThreadResolver")
  reviewComments        ReviewComment[]

  // Demo review frames and feedback intake (build plan L3; spec §6) — named
  // without the bare word "review" throughout (see DemoFrame's own comment).
  authoredDemoFrames DemoFrame[]
  ratifiedFeedback   FeedbackItem[]    @relation("FeedbackRatifiedBy")
  feedbackComments   FeedbackComment[]

  // Builds and the resolution ledger (build plan L3b; spec §6's gap) — see
  // Build's own comment.
  declaredBuilds   Build[]
  acceptedFeedback FeedbackItem[] @relation("FeedbackAcceptedBy")

  // The dependency board (build plan L5; spec §7) — see Dependency's own
  // comment. Both relations are staff in practice today (createDependency and
  // verifyDependency are both contracts.manage-gated — see
  // docs/development/L5.md), but the schema does not assume that.
  createdDependencies  Dependency[] @relation("DependencyCreatedBy")
  verifiedDependencies Dependency[] @relation("DependencyVerifiedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// GIN, because the only role-shaped read in the app is `allCustomers`, and
  /// under a set that is array containment (`roles has CUSTOMER` → `@>`),
  /// which no b-tree answers. `state` is dropped from the index rather than
  /// carried over: it is written in four places and filtered in none, so it
  /// was already a dead second column before the array made it impossible.
  @@index([roles(ops: ArrayOps)], type: Gin)
}

enum TokenPurpose {
  INVITE
  PASSWORD_RESET
}

/// Single-use, expiring links. Only the hash is stored — the raw token exists
/// once, in the link handed to the customer.
model AuthToken {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   TokenPurpose
  tokenHash String       @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime     @default(now())

  @@index([userId, purpose])
}

/// What a token may do. Deliberately two values and not a capability set:
/// scope answers *may this credential write at all*, which is a property of
/// the credential; which surfaces its owner may touch stays with
/// `lib/capabilities.ts` and is re-read from the owner on every request. A
/// token that carried its own capability list would be a snapshot of
/// someone's permissions, taken at creation, outliving any change to them —
/// the same mistake `SessionClaims` stopped making when it dropped `role`.
enum ApiTokenScope {
  /// Queries only.
  READ
  /// Queries and mutations.
  WRITE
}

/// A personal access token for calling the API without a browser. The secret
/// is returned once, at creation, and never stored — only its SHA-256 digest,
/// so a database leak yields nothing that can be replayed.
///
/// Issued to staff only (`apiTokens.manage`, ADMIN alone today). The
/// capability is re-checked on *every* request rather than trusted from
/// issue time, so demoting an admin kills their tokens without anyone having
/// to remember to revoke them — see lib/apiTokens.ts.
model ApiToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Shown in the list, so one token can be told from another. Non-blank,
  /// enforced by a CHECK in the migration — Prisma cannot express it, and an
  /// unnamed token is indistinguishable from a mistake. Deliberately *not*
  /// unique: two machines may legitimately share a name, and a uniqueness
  /// error at creation would be a worse answer than a duplicate row.
  name String

  /// SHA-256 of the whole token, unsalted. The secret is 32 bytes of CSPRNG
  /// output, so there is no low-entropy input to grind and a salt would buy
  /// nothing — while a plain digest keeps authentication one indexed lookup
  /// instead of a comparison against every row.
  tokenHash String @unique

  /// The leading characters, in plaintext, so the UI can identify a token it
  /// can never show in full again.
  prefix String

  scope ApiTokenScope @default(READ)

  /// Best-effort, written outside the request's own success — an unused token
  /// is the one that is visibly safe to revoke.
  lastUsedAt DateTime?
  /// Null means it does not expire. Enforced on read, not by a sweep.
  expiresAt  DateTime?
  /// Revocation is a tombstone rather than a delete: the row is the only
  /// record that the credential existed, and that is worth keeping.
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Contracts
// ---------------------------------------------------------------------------

/// Permissive by design (v3 §8): a contract does not march through these in
/// order — it moves back and forth as the work actually goes. WOC and WOR are
/// a "whose court is the ball in" toggle, not stages. No rigid state machine.
enum ContractStatus {
  DRAFT
  WAITING_ON_CUSTOMER
  WAITING_ON_ROOT
  IN_PROGRESS
  FINAL_REVIEW
  DONE
  DISCARDED
}

model Contract {
  id      String @id @default(cuid())
  /// Human reference shown to the customer, e.g. RC-2026-014.
  ref     String @unique
  titleFa String
  titleEn String

  customerId String
  customer   User   @relation("CustomerContracts", fields: [customerId], references: [id])

  /// Build plan D1, 2026-09-20: the registry's owner is the project, not the
  /// contract — a contract attaches to a project rather than the other way
  /// around. Nullable because L1 does not build the screens that create a
  /// project before a contract exists (lifecycle spec §4 stages 1-2); every
  /// contract migrated by L1 got one project of its own (see the L1
  /// migration), and `createContract` creates one alongside every new
  /// contract, but the column itself does not require it.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  status          ContractStatus @default(DRAFT)
  /// When the contract entered its current status. Not `updatedAt`, which any
  /// write bumps — this is what the Needs-Root queue orders by, and a queue
  /// ordered by "was touched at all" is not a queue. Set by both status
  /// writers, and only when the status actually differs (V4.md defect D7).
  statusChangedAt DateTime       @default(now())

  /// Toman. Integer — no sub-unit in practice, and no float rounding.
  /// This is the *draft* fee; a published revision carries its own frozen copy.
  amount BigInt?

  /// Set when Root hands it over; until then the customer cannot see it.
  publishedAt DateTime?

  /// The live published pair. The two lineages advance on separate clocks —
  /// publishing a design revision never touches the contract's approval or
  /// signature, and vice versa. Null before the first revision is published.
  currentContractRevisionId String?           @unique
  currentContractRevision   ContractRevision? @relation("CurrentContractRevision", fields: [currentContractRevisionId], references: [id])
  currentDesignRevisionId   String?           @unique
  currentDesignRevision     DesignRevision?   @relation("CurrentDesignRevision", fields: [currentDesignRevisionId], references: [id])

  contractRevisions ContractRevision[] @relation("ContractRevisions")
  designRevisions   DesignRevision[]   @relation("ContractDesignRevisions")

  // ScopeItem re-parented to Project at L1 (build plan D1) — reached here via
  // `project.scopeItems`, never a direct relation. See Project and ScopeItem
  // below.
  articles   Article[]
  comments   Comment[]
  changeLogs ChangeLog[]
  billing    BillingEntry[]
  files      StoredFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, status])
  @@index([status, statusChangedAt])
}

// ---------------------------------------------------------------------------
// Revisions — two independent lineages from one contract
// ---------------------------------------------------------------------------
//
// Where the draft lives is deliberately different on each side, because the
// storage is:
//
//   Contract — a legal document. A published revision is an immutable JSON
//     snapshot with a hash, which is exactly what a signature should attest to.
//     The *draft* is the mutable `Article` rows (plus title/amount) still
//     hanging off `Contract`; publishing serializes them into a revision.
//
//   Design — interactive. The customer approves pages one at a time, so it
//     stays relational and a revision is simply the rows sharing a
//     `designRevisionId`. The *draft* is a DesignRevision with `publishedAt`
//     null, edited in place until it is published.
//
// Both are immutable once published. Editing always produces the next draft.

/// One frozen version of the contract text. Immutable once published; a
/// signature binds here, never to the contract in the abstract.
model ContractRevision {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation("ContractRevisions", fields: [contractId], references: [id], onDelete: Cascade)

  version Int

  /// Canonically serialized: stable key order, the fee as a decimal string
  /// (BigInt does not survive JSON), dates as ISO-8601. See lib/revision.ts —
  /// without a canonical form the same contract hashes two ways and the hash
  /// attests to nothing.
  ///
  /// Null means **unsealed**: the row was created by the backfill migration,
  /// which cannot canonicalize in SQL without forking that logic. `npm run
  /// backfill` fills it. Publishing always sets both, so null only ever
  /// appears on a backfilled v1, and signing refuses an unsealed revision.
  snapshot    Json?
  /// sha256 of the canonical snapshot, hex. What the signature stands against.
  contentHash String?

  publishedAt  DateTime?
  approvedAt   DateTime?
  /// Set when a later revision replaces this one. A *signed* revision is
  /// terminal and is never superseded — changes after signature are amendments.
  supersededAt DateTime?

  signature  Signature?
  amendments Amendment[]
  currentFor Contract?   @relation("CurrentContractRevision")

  createdAt DateTime @default(now())

  @@unique([contractId, version])
}

/// One version of the design: its concepts, their pages, and the approvals
/// held inside it.
///
/// At most one row per contract may have `publishedAt IS NULL` — the draft
/// Root is currently editing. Prisma's `@@unique` cannot express a partial
/// index, so it is hand-written in the migration as
/// `DesignRevision_one_draft_per_contract` (defect D5). Do not assume the
/// constraint exists just because this comment says so if you are reading an
/// older migration set — check the migration itself.
model DesignRevision {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation("ContractDesignRevisions", fields: [contractId], references: [id], onDelete: Cascade)

  version Int

  publishedAt  DateTime?
  supersededAt DateTime?

  concepts   DesignConcept[]
  currentFor Contract?       @relation("CurrentDesignRevision")

  createdAt DateTime @default(now())

  @@unique([contractId, version])
}

/// Layered on top of a *signed* base revision rather than replacing it —
/// paper contracts are not re-issued, they get an addendum both parties sign.
/// The effective contract is the signed base plus every accepted amendment in
/// ordinal order; the base's signature is never invalidated.
model Amendment {
  id                 String           @id @default(cuid())
  contractRevisionId String
  contractRevision   ContractRevision @relation(fields: [contractRevisionId], references: [id], onDelete: Cascade)

  /// A1, A2, … in order.
  ordinal Int

  titleFa String
  titleEn String
  bodyFa  String
  bodyEn  String

  contentHash String

  /// An optional, non-authoritative display hint (spec §5.3): the print view
  /// still shows the sealed article untouched and renders the amendment
  /// beside it, marked. Deliberately not a supersede — recomputing the
  /// effective article set would make the readable contract a *computed*
  /// document, which is the second candidate for "the document" lib/revision.ts
  /// exists to prevent.
  relatesToArticle Int?

  publishedAt DateTime?
  approvedAt  DateTime?

  signature  Signature?
  /// The paired amendment a scope trade updates the contract view through
  /// (spec §4, build plan L1) — set once a trade executes. Null for every
  /// amendment issued the ordinary way.
  scopeTrade ScopeTrade?

  createdAt DateTime @default(now())

  @@unique([contractRevisionId, ordinal])
}

/// A whole design direction (1a / 1b / 1c). Exactly one may be chosen; choosing
/// a different one within a revision resets the page approvals beneath it.
model DesignConcept {
  id               String         @id @default(cuid())
  designRevisionId String
  designRevision   DesignRevision @relation(fields: [designRevisionId], references: [id], onDelete: Cascade)

  /// Short id shown on the card: "1a", "1b", "1c".
  key         String
  labelFa     String
  labelEn     String
  /// Uploaded preview. Null until Root uploads one — the UI falls back to the
  /// placeholder browser-chrome block. Set from `imageFile`, never by hand:
  /// see the note on PageDesign.imageUrl for why both fields exist.
  imageUrl    String?
  imageFileId String?
  imageFile   StoredFile? @relation("ConceptImage", fields: [imageFileId], references: [id], onDelete: Restrict)
  position    Int         @default(0)

  chosenAt DateTime?

  pages PageDesign[]

  @@unique([designRevisionId, key])
}

/// One page's design under a concept (Landing, About, Contracts, Portal login).
model PageDesign {
  id        String        @id @default(cuid())
  conceptId String
  concept   DesignConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  key     String
  labelFa String
  labelEn String

  /// Why two fields for one image.
  ///
  /// `imageUrl` is what the client renders *and* what `lib/design.ts` compares
  /// to decide whether a page changed between revisions — so it has to be a
  /// plain, stable string. `imageFileId` is the referential half: it lets the
  /// database answer "is this file still in use", and `onDelete: Restrict`
  /// makes deleting an image a published revision depends on impossible rather
  /// than merely discouraged.
  ///
  /// They are written together and only together (`lib/files.ts`), with
  /// `imageUrl` derived as `/files/<id>`. A null `imageFileId` beside a set
  /// `imageUrl` is legal and means an externally hosted image — the only shape
  /// available before uploads existed.
  imageUrl    String?
  imageFileId String?
  imageFile   StoredFile? @relation("PageImage", fields: [imageFileId], references: [id], onDelete: Restrict)
  position    Int         @default(0)

  approvedAt DateTime?

  /// L2's design-image toggle reads `imageUrl` and `key` from here through a
  /// DemoPage — never a reason for this model to write anything back. D5
  /// stays decided: no code reached through this relation may set
  /// `approvedAt` above or `DesignConcept.chosenAt`.
  demoPages DemoPage[]

  @@unique([conceptId, key])
}

// ---------------------------------------------------------------------------
// Files
// ---------------------------------------------------------------------------
//
// The bytes live on disk (`lib/storage.ts`); this table is the part the
// database has to know about, which is *who may read them*. A file record
// without an owner cannot be authorised, so the two visibilities are not
// cosmetic:
//
//   PRIVATE — belongs to exactly one contract. Served by the API only after
//     checking the caller is that contract's customer, or an admin.
//   PUBLIC  — served straight off disk by Nginx, never through Node.
//
// Both exist from the first migration on purpose (build plan §F1): the split
// is what decides the storage key, and retrofitting it means re-keying every
// file already written.

enum FileVisibility {
  PRIVATE
  PUBLIC
}

/// What kind of thing this is — which sets the size limit and the accepted
/// types (`lib/files.ts`). Not the same axis as visibility: the Research Lab
/// keeps a per-entry public/private flag, so a research text can be either.
enum FileClass {
  /// Concept and page previews for a contract's design. Customer-private.
  DESIGN_IMAGE
  /// Hosted full text in the Research Lab. Not yet produced by anything.
  RESEARCH_TEXT
  /// Build plan L7, spec §9: a product spreadsheet uploaded to the
  /// product-import panel. Customer-private, owned by a Project rather than
  /// a Contract — the first file class this schema attaches to a project
  /// directly (StoredFile.projectId).
  SERVICE_IMPORT
}

model StoredFile {
  id String @id @default(cuid())

  /// Opaque path within STORAGE_DIR, assigned by the storage layer. Never
  /// derived from the uploaded filename — that string is attacker-controlled.
  key String @unique

  class      FileClass
  visibility FileVisibility

  /// The type the server determined, not the one the client claimed.
  mime         String
  bytes        Int
  /// Only ever echoed back in a download filename, never used as a path.
  originalName String

  /// The ownership edge the private check reads. Null for PUBLIC files;
  /// required for PRIVATE ones — enforced by a CHECK constraint in the
  /// migration, because a private file nobody owns is one nobody can ever
  /// be authorised to read. Build plan L7 widens the CHECK
  /// (`StoredFile_private_has_owner`) to accept `projectId` as an
  /// equally-valid owner, since SERVICE_IMPORT is the first class this
  /// schema attaches to a project rather than a contract.
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)

  /// Build plan L7: the owning row for a SERVICE_IMPORT upload. Null for
  /// every other class, exactly the same asymmetry `contractId` already has
  /// with RESEARCH_TEXT.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  conceptImages DesignConcept[] @relation("ConceptImage")
  pageImages    PageDesign[]    @relation("PageImage")
  /// The other asymmetry to `contractId`: an entry has *one* full text and
  /// the edge lives on the entry (§1.1), so this side is a nullable scalar,
  /// not an array — a contract has many files, an entry's hosted text is one.
  entryFullText LibraryEntry?   @relation("EntryFullText")
  /// Build plan L7 — the run this upload belongs to, if it has been turned
  /// into one yet (createServiceRun is a separate act from the upload
  /// itself, matching the two-step shape POST /upload already has
  /// everywhere else in this codebase).
  serviceRun    ServiceRun?

  /// The Anthropic Files API id for this PDF's bytes (R4.md §2.3) — set the
  /// first time a `quotableFullText` entry is asked about, never re-uploaded
  /// after. Null for every DESIGN_IMAGE row and for a RESEARCH_TEXT row never
  /// asked about yet. Cleared (never left dangling) wherever this row's bytes
  /// are removed — deleting a StoredFile is already the one moment its `key`
  /// stops meaning anything, and this id is exactly the same kind of pointer.
  anthropicFileId         String?
  anthropicFileUploadedAt DateTime?

  createdAt DateTime @default(now())

  @@index([contractId])
  @@index([projectId])
  @@index([class, visibility])
}

// ---------------------------------------------------------------------------
// Projects & the scope registry (build plan L1, 2026-09-20; spec §3-4)
// ---------------------------------------------------------------------------
//
// D1: the registry's owner is a Project, not a Contract. A Contract attaches
// to a Project (nullable projectId above) rather than owning the registry —
// Contact and Scoping (spec §4 stages 1-2) produce a project and a seeded
// registry before any contract exists, and a wedge customer's design contract
// and build contract share one registry rather than each copying it (which
// would destroy `origin`, the field that answers "where did this come from").

enum ProjectStatus {
  ACTIVE
  /// Not currently set by anything — reserved for when a project can be
  /// closed out. Later stages (L2's phases) are expected to read finer
  /// lifecycle state off phases and the registry rather than growing this
  /// enum, so it stays two values on purpose.
  ARCHIVED
}

/// The registry's owner (D1): customer, status, and the scope items. Phases,
/// demos and dependencies (L2, L5) hang off this in later stages.
model Project {
  id String @id @default(cuid())

  customerId String
  customer   User   @relation("CustomerProjects", fields: [customerId], references: [id])

  titleFa String
  titleEn String

  status ProjectStatus @default(ACTIVE)

  contracts     Contract[]
  scopeItems    ScopeItem[]
  scopeTrades   ScopeTrade[]
  phases        Phase[]
  builds        Build[]
  /// Build plan L4 — nullable on the Ticket side; a project reads this as
  /// "every ticket ever attached to it," never the other way around.
  tickets       Ticket[]
  /// Build plan L5 — symmetric commitments, both sides, one board.
  dependencies  Dependency[]
  /// Build plan L6 — nullable on the Subscription side; see its own comment.
  subscriptions Subscription[]
  /// Build plan L7 — the product-import panel's uploaded spreadsheets.
  files         StoredFile[]
  /// Build plan L7 — the product-import panel's run history.
  serviceRuns   ServiceRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

/// Status lifecycle (spec §3; build plan L1): `proposed` at scoping, `agreed`
/// once settled, `inBuild`/`inDemo` as it moves through a phase (L2), and
/// `accepted` once a demo review closes it out (L3). `declined` and `traded`
/// are terminal — a declined item stays in the record rather than being
/// deleted, and a traded item's replacement is a new row linked through
/// ScopeTrade, never an edit in place.
enum ScopeStatus {
  PROPOSED
  AGREED
  IN_BUILD
  IN_DEMO
  ACCEPTED
  DECLINED
  TRADED
}

/// Appendix 1, grown from a flat tickable checklist into the registry every
/// other document reads from (spec §3). `checkedAt` is kept exactly as it
/// was — the customer's own tick on the working checklist — and is never
/// backfilled into `status`: they are different acts. `status` tracks where
/// an item stands in the build lifecycle; `checkedAt` tracks only whether the
/// customer ticked the box on the appendix. Conflating them at the L1
/// migration would write a false history into the one record whose purpose
/// is being true (build plan L1, banked trap #1).
///
/// Never gated — the customer can tick `checkedAt` at any point, whatever
/// `status` says.
model ScopeItem {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  key      String
  labelFa  String
  labelEn  String
  position Int    @default(0)

  checkedAt DateTime?

  status ScopeStatus @default(PROPOSED)

  /// A known stand-in — e.g. the SMS-less auth Nahal shipped with. Never
  /// gates anything; the review frame (L3) reads it to say so in plain terms.
  temporary Boolean @default(false)

  /// Deliberately settled post-design, with a date and a pointer to what
  /// settled it. Both or neither — held by a CHECK constraint added by hand
  /// in the migration, since Prisma cannot express "these two columns agree".
  /// There is no formal decision-record model yet (that is L3's round, or
  /// L3b's build), so the pointer is a free-text note naming the decision —
  /// a call, a message, a round — rather than a foreign key invented ahead of
  /// the object it would eventually point at.
  decidedAt   DateTime?
  decidedNote String?

  outOfScope Boolean @default(false)
  adminWork  Boolean @default(false)

  /// Recorded when `status` is DECLINED. Optional rather than CHECK-enforced
  /// — contrast L3b's `Build` outcome, which the build plan holds to a CHECK
  /// on exactly this shape. The completeness checklist below is seeded
  /// DECLINED by default specifically so its *absence* of coverage is visible
  /// before anyone has had the chance to write a reason for it.
  declinedReason String?

  /// Origin (spec §3): who asked, when, in which round — so "where did
  /// bilingual come from" has an answer. No Round or Ticket-thread model
  /// exists yet to point at (that arrives with L3's review frame), so this
  /// stays three plain fields rather than a relation invented ahead of the
  /// object it would relate to.
  originNote    String?
  originRound   String?
  originAskedAt DateTime @default(now())

  /// Set once this item is the "out" or "in" half of a scope trade (spec §4).
  /// At most one of each per item — the unique constraints live on
  /// ScopeTrade's own foreign keys.
  tradedOut ScopeTrade? @relation("TradeOut")
  tradedIn  ScopeTrade? @relation("TradeIn")

  /// Which phase (L2) is building this item. Nullable — an item can be
  /// agreed long before a phase exists to carry it, and the registry must
  /// not force an assignment just to be editable.
  phaseId String?
  phase   Phase?  @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  /// Frame lines generated from this item (build plan L3) — a snapshot of its
  /// label at generation time, not a live view (see DemoFrameLine's own
  /// comment), so this relation exists for provenance and for reading the
  /// item's *current* temporary/decidedAt flags at interception time, never
  /// for the line's displayed text.
  frameLines       DemoFrameLine[]
  /// Set on a FeedbackItem when a comment against this item's frame line was
  /// filed after it was already `decided` or `temporary`, and the submitter
  /// chose to proceed (D4's interception, recorded rather than only prompted).
  reopenedFeedback FeedbackItem[]  @relation("FeedbackReopenedScopeItem")

  /// A build's change list naming "this was on the plan" (build plan L3b) —
  /// each entry moves this item to IN_DEMO at declaration time. A row here
  /// per build that shipped it, not per phase — the same item could
  /// conceivably be re-shipped after a regression, though nothing in this
  /// stage produces that on purpose.
  buildChangeEntries BuildChangeEntry[]

  @@unique([projectId, key])
}

/// Paired movements — one item out, one in — recorded as a single row so the
/// two ends can never drift apart (spec §4: "swap item X for item Y of
/// comparable weight"). Both parties confirm before it executes and the
/// contract view updates via a paired amendment.
///
/// **The customer-confirm half is not wired to a mutation this stage** — see
/// docs/development/L1.md. `customerConfirmedAt` exists so executing a trade
/// is already gated on both signatures the day the portal side lands, rather
/// than becoming a second migration.
model ScopeTrade {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  outItemId String    @unique
  outItem   ScopeItem @relation("TradeOut", fields: [outItemId], references: [id], onDelete: Restrict)
  inItemId  String    @unique
  inItem    ScopeItem @relation("TradeIn", fields: [inItemId], references: [id], onDelete: Restrict)

  proposedById String
  proposedBy   User     @relation(fields: [proposedById], references: [id])
  proposedAt   DateTime @default(now())

  rootConfirmedAt     DateTime?
  customerConfirmedAt DateTime?

  executedAt  DateTime?
  /// The paired amendment updating the contract view, written once the trade
  /// executes. Null until then, and null forever for a project with no
  /// signed contract to amend.
  amendmentId String?    @unique
  amendment   Amendment? @relation(fields: [amendmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Phases and the live demo surface (build plan L2, 2026-09-20; spec §4 stage
// 6, §6). A Phase binds scope items, page designs (through DemoPage below),
// a demo, and a milestone. Portal-visible progress is derived from this and
// the registry (lib/phase.ts's computePhaseProgress) — never a hand-typed
// percentage (F5's own slippage, and the trap this section exists to avoid).
// ---------------------------------------------------------------------------

/// A slice of the build, ordered. "Phase 3 of 5" reads `number` against the
/// sibling count; nothing on this model is a status a person sets by hand —
/// what stage a phase is at is read off its scope items' own `status`.
model Phase {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Project-scoped ordinal, not a global one — two projects both have a
  /// "phase 1".
  number  Int
  titleFa String
  titleEn String

  /// A minimal stand-in for the real thing (spec §8's milestone linkage,
  /// L6). Free text — "Payment 2 of 4" — rather than a relation to
  /// BillingEntry/Subscription, neither of which exists yet. Widen this to a
  /// real Milestone model when L6 lands rather than before; a relation to an
  /// object that does not exist yet is a column that acquires a wrong
  /// meaning before a right one (R1's own reasoning, reapplied).
  milestoneLabel String?

  scopeItems     ScopeItem[]
  demos          Demo[]
  builds         Build[]
  /// Build plan L6, spec §8's milestone linkage — every charge gated on this
  /// phase's acceptance. See BillingEntry.phaseId's own comment for why this
  /// reuses the phase rather than a separate Milestone model.
  billingEntries BillingEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, number])
}

/// The live staging site, embedded (D2) — never a set of captures, and never
/// a rewriting proxy (D2 rejects that outright). `stagingUrl` must be HTTPS
/// or a browser will not frame it at all (L2.2) — validated where this is
/// written, not only read back.
model Demo {
  id      String @id @default(cuid())
  phaseId String
  phase   Phase  @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  stagingUrl String

  /// D2's "record the build reference on the demo," kept deliberately
  /// trivial — a plain string, not yet an object. L3b grows this into a real
  /// `Build` with its own change list; nothing here should make that
  /// migration harder than adding a column and copying values across.
  buildRef String?

  /// The review window is a *convention*, not machinery (D2, L2.2): Root
  /// stops deploying to staging between these two dates by habit, and the
  /// review frame (L3) generates its "do not expect changes right now"
  /// sentence from them. No deploy-lock exists or is planned here.
  reviewWindowStart DateTime?
  reviewWindowEnd   DateTime?

  /// Build plan L3, spec §6: "a demo cannot be published naked." Null means
  /// draft — visible to staff while they shape phases, pages and the frame,
  /// invisible to the customer's own portal query. `publishDemo` is the only
  /// writer, and it refuses without a `frame` already authored (NO_FRAME).
  publishedAt DateTime?

  /// The review frame (spec §6) — at most one per demo. See DemoFrame's own
  /// comment for why this is not named anything containing "review".
  frame DemoFrame?

  pages          DemoPage[]
  unmatchedPaths DemoUnmatchedPath[]
  feedbackItems  FeedbackItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phaseId])
}

/// The page list a demo declares "from the registry" (L2.1) — what makes a
/// reported path mean anything at all. Declared by Root, never inferred: an
/// unrecognized path becomes a DemoUnmatchedPath, never a guessed DemoPage.
model DemoPage {
  id     String @id @default(cuid())
  demoId String
  demo   Demo   @relation(fields: [demoId], references: [id], onDelete: Cascade)

  key     String
  labelFa String
  labelEn String

  /// What `lib/demoPages.ts`'s `normalizePath()` reduces a reported path to,
  /// for comparison. See that file for exactly what does and does not fold
  /// together — a trailing slash and a locale prefix, yes; a pagination
  /// segment, deliberately not (L2.1 names that case as genuinely
  /// undetermined, not a bug to fix here).
  canonicalPath String

  /// The design-image toggle (L2.1: "near zero, conditional on the
  /// mapping"). Optional — a demo can declare a page before any design
  /// exists for it. Reads `PageDesign.imageUrl` and `.key` only; nothing in
  /// this stage writes `approvedAt` or `chosenAt` (D5 stays decided).
  pageDesignId String?
  pageDesign   PageDesign? @relation(fields: [pageDesignId], references: [id], onDelete: SetNull)

  /// At most one — feedback against a page collapses onto this single row
  /// (build plan L3, D4), same mechanism as DemoFrameLine.feedbackItem below.
  feedbackItem FeedbackItem?

  @@unique([demoId, key])
  @@index([demoId, canonicalPath])
}

/// "A page we did not expect" (L2.2) — every reported path that did not
/// match a declared DemoPage, deduplicated by its own normalized form and
/// counted rather than dropped. A note filed against an unrouted path is the
/// dead-end failure (F2) rebuilt one level down; this table is what keeps
/// that failure from being silent, and what the desk reads to notice it.
model DemoUnmatchedPath {
  id     String @id @default(cuid())
  demoId String
  demo   Demo   @relation(fields: [demoId], references: [id], onDelete: Cascade)

  /// Already run through normalizePath() — two raw paths that normalize the
  /// same are one "we did not expect this" fact, not two, so the raw path is
  /// not kept at all.
  normalizedPath String

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  count       Int      @default(1)

  @@unique([demoId, normalizedPath])
}

// ---------------------------------------------------------------------------
// Review frames and feedback intake (build plan L3, 2026-09-21; spec §6) —
// the product thesis, testable. Named deliberately without the bare word
// "review" in any identifier: `desk/sections.ts` already has `review` and
// `reviewAdmin` for the Review Room (Root's own documents read by outside
// specialists), an entirely different feature, and this codebase already
// lost that naming fight once (build plan L3's first banked trap). The desk
// section for this stage is `demos`; "review frame" and "demo review" stay
// prose, never an identifier — hence `DemoFrame`, not `ReviewFrame`.
// ---------------------------------------------------------------------------

/// The review frame itself (spec §6) — at most one per Demo. Publishing a
/// demo (`publishDemo`) refuses without one (`NO_FRAME`): "a demo cannot be
/// published naked" is the mechanism, not a suggestion.
///
/// Authoring is mostly generation from the registry (`generateDemoFrame`,
/// additive-only — see DemoFrameLine), plus whatever Root types by hand.
model DemoFrame {
  id     String @id @default(cuid())
  demoId String @unique
  demo   Demo   @relation(fields: [demoId], references: [id], onDelete: Cascade)

  authoredById String
  authoredBy   User   @relation(fields: [authoredById], references: [id])

  /// Freeform context beside the generated lines — e.g. the freeze-window
  /// sentence D2/L2.2 already banks as a plain fact. Optional: a frame can be
  /// entirely generated lines with nothing added by hand.
  summaryFa String?
  summaryEn String?

  lines DemoFrameLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The four buckets spec §6 asks the frame to project from the registry:
/// what's new, what's known-missing, what's temporary, what's decided.
enum DemoFrameLineKind {
  NEW
  KNOWN_MISSING
  TEMPORARY
  DECIDED
}

/// One line of the frame — a commentable target in its own right (see
/// FeedbackItem), alongside a DemoPage, so a reviewer can react to "SMS is
/// still missing" without that reaction having anywhere else to anchor.
///
/// `textFa`/`textEn` are a **snapshot** of the source scope item's label at
/// generation time, the same reasoning `agreedScopeSnapshot` already uses for
/// Appendix 1 — a label edited on the registry later must not silently
/// rewrite what a past review frame said.
model DemoFrameLine {
  id      String    @id @default(cuid())
  frameId String
  frame   DemoFrame @relation(fields: [frameId], references: [id], onDelete: Cascade)

  kind     DemoFrameLineKind
  textFa   String
  textEn   String
  position Int               @default(0)

  /// Where this line was generated from, and — critically — the live pointer
  /// interception (D4) reads `temporary`/`decidedAt` from. SetNull, not
  /// Cascade: deleting the scope item later must not delete a line (or the
  /// feedback anchored to it) that already shipped in a published frame; it
  /// simply stops being able to trigger interception. Null for a line Root
  /// typed by hand (`addDemoFrameLine`).
  scopeItemId String?
  scopeItem   ScopeItem? @relation(fields: [scopeItemId], references: [id], onDelete: SetNull)

  feedbackItem FeedbackItem?

  /// Build plan L3b's third source, turned into genuine bilingual prose: set
  /// when a PM used addDemoFrameLine to write up an unprompted build change
  /// (schema.prisma's DemoFrameLine — see BuildChangeEntry.note's comment on
  /// why the raw note is not copied here automatically). Unique — at most one
  /// line is ever the write-up of a given entry. Null for every other line.
  buildChangeEntryId String?           @unique
  buildChangeEntry   BuildChangeEntry? @relation(fields: [buildChangeEntryId], references: [id], onDelete: SetNull)

  @@index([frameId, kind, position])
}

/// Fates a feedback item can occupy (spec §6: "every item shows its fate —
/// accepted / done / declined-because"). L3 writes and reads OPEN and
/// RATIFIED; ADDRESSED/ACCEPTED/DECLINED are the states L3b's build ledger
/// will write (build plan L3b) — banked here as the full enum on the same
/// precedent L1 used for `ScopeStatus.ACCEPTED` (built before anything could
/// reach it), so the surface this stage builds can already render whatever a
/// later stage sets, rather than needing a second migration to add them.
enum FeedbackStatus {
  /// Submitted, unratified — an opinion (spec §6 / F8), visible but inert.
  OPEN
  /// The decider (D3) ratified the batch this item was part of — actionable.
  RATIFIED
  /// L3b: the developer claims this was addressed in a build. Not yet the
  /// customer's acceptance — see build plan L3b.2's "two fields, never one."
  ADDRESSED
  /// The customer met it in the next review and did not reopen it.
  ACCEPTED
  /// Declined, with its reason — spec §6's "declined-*because*."
  DECLINED
}

/// Per-item feedback intake (spec §6) — never a comment blob. Binds to a demo
/// page or a frame line, exactly one of the two, the same shape Signature
/// already uses for contractRevisionId/amendmentId — enforced by a
/// hand-written CHECK in the migration (Prisma cannot express it).
///
/// **Duplicate collapse lives in the two unique constraints below** (build
/// plan D4): a second submission against a target that already has a row
/// here never reaches `create` — `submitFeedback` looks the row up first and
/// appends a FeedbackComment instead. No model, no semantic matcher — it
/// keys off the same target row, which is what "dumb" (D4) means in code.
model FeedbackItem {
  id     String @id @default(cuid())
  demoId String
  demo   Demo   @relation(fields: [demoId], references: [id], onDelete: Cascade)

  demoPageId  String?        @unique
  demoPage    DemoPage?      @relation(fields: [demoPageId], references: [id], onDelete: Cascade)
  frameLineId String?        @unique
  frameLine   DemoFrameLine? @relation(fields: [frameLineId], references: [id], onDelete: Cascade)

  status FeedbackStatus @default(OPEN)

  /// D4's interception, recorded rather than only prompted-and-forgotten: set
  /// when the target resolved to a `decided` or `temporary` scope item at
  /// submission time and the submitter chose to proceed anyway. An item that
  /// was never intercepted has this null; an interception the submitter did
  /// *not* confirm never becomes a row at all (see `submitFeedback`).
  reopenedScopeItemId String?
  reopenedScopeItem   ScopeItem? @relation("FeedbackReopenedScopeItem", fields: [reopenedScopeItemId], references: [id], onDelete: SetNull)

  /// Ratification (spec §6, D3) — the decider approves a batch. Recorded
  /// here, per item, rather than bound to `Signature` (build plan L3's
  /// banked trap #4): a signature attests to hashed bytes of a legal
  /// instrument, and "the customer approved this feedback batch" is not that,
  /// however signature-shaped it looks — who decided what, when, without
  /// widening the one model where "signature" is load-bearing.
  ratifiedAt   DateTime?
  ratifiedById String?
  ratifiedBy   User?     @relation("FeedbackRatifiedBy", fields: [ratifiedById], references: [id])

  /// Build plan L3b.2's first rule, held as two columns rather than one: the
  /// developer's claim. Set by declareBuild the moment a change entry
  /// disposes this item ADDRESSED; cleared (never left dangling) the moment
  /// a new comment reopens it (lib/feedback.ts's reopensOnComment) — a stale
  /// pointer at a build that no longer describes this item's current state
  /// would be exactly the silent-in-Root's-favour failure this rule exists
  /// to prevent.
  addressedInBuildId String?
  addressedInBuild   Build?  @relation(fields: [addressedInBuildId], references: [id], onDelete: SetNull)

  /// The second, separate write L3b.2 insists on: the customer (or staff)
  /// met this in the next review and did not reopen it. Written only by
  /// acceptFeedback, and only from ADDRESSED — never inferred from
  /// addressedInBuildId being set, which would collapse the very distinction
  /// this pair of fields exists to hold apart.
  acceptedAt   DateTime?
  acceptedById String?
  acceptedBy   User?     @relation("FeedbackAcceptedBy", fields: [acceptedById], references: [id])

  comments           FeedbackComment[]
  buildChangeEntries BuildChangeEntry[]

  /// Build plan L4: set once this item becomes a change ticket
  /// (createTicketFromFeedback) — the back half of Ticket.sourceFeedbackItem.
  /// Null for every item still living purely in the build-feedback channel.
  ticket Ticket?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([demoId, status])
}

/// The individual voices on one feedback item (spec §6, F8: "any number of
/// customer-side contributors may comment; a batch becomes actionable only
/// when the decider ratifies"). The first comment is written together with
/// the item; every submission after the first against the same target
/// appends here instead of creating a second item (D4).
model FeedbackComment {
  id             String       @id @default(cuid())
  feedbackItemId String
  feedbackItem   FeedbackItem @relation(fields: [feedbackItemId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])
  body     String

  createdAt DateTime @default(now())

  @@index([feedbackItemId, createdAt])
}

// ---------------------------------------------------------------------------
// Builds and the resolution ledger (build plan L3b, 2026-09-21; spec §6's
// gap) — the loop's other half. L3 lets the customer submit and promises
// every item shows its fate; this is where a fate gets written, by the
// developer, at the moment they put a new version on staging. Also the
// review frame's third source of "what's new" — a change that came from
// neither a scope item nor a feedback item (a refactor, a fix found in
// passing) — see BuildChangeEntry and DemoFrameLine.buildChangeEntryId.
// ---------------------------------------------------------------------------

/// A declared state of the staging site at a point in time, belonging to a
/// phase (build plan L3b.1) — D2's bare `Demo.buildRef` string, grown
/// straight into the object rather than kept alongside it. **Not a
/// revision**: nothing here is hash-sealed, and a build is a pointer at a
/// live site, sealed against nothing (L3b.3's first banked trap — the same
/// naming collision as L3's `review`, one stage later). **Not a `ReviewRound`**
/// either — that is the Review Room's own word for a different freeze.
model Build {
  id String @id @default(cuid())

  phaseId String
  phase   Phase  @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  /// Denormalized off `phase.projectId` so the numbering below can be
  /// project-wide without a join through Phase on every read.
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Latin figures, always (house rule 14) — a version, not a count.
  /// **Project-wide and monotonic**, never reset per phase: a per-phase
  /// counter makes "version 2" ambiguous the day a project has a second
  /// phase with its own build, which is exactly the sentence a customer
  /// repeats back to Root. See lib/build.ts's nextBuildNumber and
  /// @@unique below, which is the backstop against two concurrent declares.
  number Int

  deployedAt   DateTime @default(now())
  declaredById String
  declaredBy   User     @relation(fields: [declaredById], references: [id])

  /// Commit or tag. Optional — this stage does not integrate with git, and a
  /// build may be declared before a ref is even decided.
  ref String?

  /// Publishing notifies the project's customer (build plan L3b.2's fourth
  /// rule) — null means declared but not yet told about, the same shape
  /// `Demo.publishedAt` already uses for "a deployment is not a version
  /// until someone is told." Every FeedbackItem/ScopeItem transition a
  /// build's change list makes happens at *declaration*, not held back for
  /// this second click — L3b's own framing is that the fate is written "at
  /// the moment they put a new version on staging."
  publishedAt DateTime?

  changes BuildChangeEntry[]

  createdAt    DateTime       @default(now())
  FeedbackItem FeedbackItem[]

  @@unique([projectId, number])
  @@index([phaseId])
}

/// Which claim a change entry makes about a feedback item — never the
/// customer's acceptance, which is FeedbackItem.acceptedAt, a separate write
/// (build plan L3b.2's first rule: two fields, never one).
enum BuildChangeOutcome {
  /// The developer's claim. Requires the feedback item to already be
  /// RATIFIED (lib/build.ts's outcomeAllowedForStatus) — addressing an
  /// opinion nobody has ratified yet would let a build bypass D3's own gate.
  ADDRESSED
  /// Requires `note` — the CHECK below holds "declined-*because*" at the
  /// database (build plan L3b.2's third rule), not only in a resolver that
  /// could forget to ask. Also requires RATIFIED, same reasoning as ADDRESSED.
  DECLINED
  /// The explicit "still open, carried forward" (L3b.2's second rule) — the
  /// only legal disposition for a merely-OPEN (unratified) item, and always
  /// legal for a RATIFIED one too. Writes nothing to the item's own status:
  /// nothing changed, so nothing about the row should say otherwise.
  CARRIED_FORWARD
}

/// One entry in a build's change list — the developer's disposition of a
/// feedback item, the record of a scope item shipping, or an unprompted
/// change nobody asked for (build plan L3b.1's table: one list, one optional
/// origin, not two lists). **Authored prose about the product, never an
/// audit trail** — L3b.3's test for telling this apart from `ChangeLog`: the
/// system writes a ChangeLog, a person writes a change entry.
model BuildChangeEntry {
  id      String @id @default(cuid())
  buildId String
  build   Build  @relation(fields: [buildId], references: [id], onDelete: Cascade)

  /// At most one of these, or neither (build plan L3b.1's table) — enforced
  /// by BuildChangeEntry_at_most_one_origin below, the same route
  /// FeedbackItem_exactly_one_target already takes for the stricter version
  /// of this shape (exactly one, never neither).
  feedbackItemId String?
  feedbackItem   FeedbackItem? @relation(fields: [feedbackItemId], references: [id], onDelete: SetNull)
  scopeItemId    String?
  scopeItem      ScopeItem?    @relation(fields: [scopeItemId], references: [id], onDelete: SetNull)

  /// Set exactly when feedbackItemId is (validated in lib/build.ts, not
  /// CHECK-enforced — the same "can be tightened later" precedent L1 left
  /// ScopeItem.declinedReason on). A scope-item-origin or no-origin entry is
  /// not something ratified or declined; it is simply documented as done.
  outcome BuildChangeOutcome?

  /// The authored prose. Required — structurally, via the CHECK below — when
  /// `outcome` is DECLINED ("declined-*because*") or when there is no origin
  /// at all ("the note *is* the entry", L3b.1). Optional otherwise: a scope
  /// item or an ADDRESSED/CARRIED_FORWARD feedback item is already labelled
  /// by what it points at.
  note String?

  /// Which language `note` was authored in ("fa" or "en") — not a second,
  /// required translation column. Build plan L3b.3's Persian-authorship
  /// decision: the developer may not write Persian, and a change note the
  /// customer cannot read is worse than one the PM renders at review time
  /// (see DemoFrameLine.buildChangeEntryId). Null exactly when note is.
  noteLang String?

  /// The line a PM eventually wrote up from this entry, in genuine bilingual
  /// prose, once it reached a review frame (DemoFrameLine's own comment).
  /// Null until then; always null for a feedback- or scope-item-origin entry,
  /// which already have a home in the frame without this.
  frameLine DemoFrameLine?

  createdAt DateTime @default(now())

  @@index([buildId])
  @@index([feedbackItemId])
}

/// The fourteen articles plus Appendix 1, as the editable **draft**. Body text
/// is optional so a contract can be published with the structure in place and
/// the text filled in later. What a customer reads is the snapshot inside the
/// current ContractRevision, not these rows.
model Article {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  number  Int
  titleFa String
  titleEn String
  bodyFa  String?
  bodyEn  String?

  @@unique([contractId, number])
}

enum CommentTarget {
  DESIGN
  CONTRACT
}

/// Free at all times, on designs and on the contract. Never gated.
model Comment {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  target CommentTarget @default(CONTRACT)
  body   String

  createdAt DateTime @default(now())

  @@index([contractId, createdAt])
}

/// Binds to a **contract revision or an amendment**, exactly one of the two —
/// enforced by a CHECK constraint, since Prisma cannot express it. It used to
/// bind to the contract, which was the one constraint versioning genuinely
/// breaks: amendments each carry their own signature, so one-per-contract is
/// wrong. Unique on each side keeps one signature per instrument.
model Signature {
  id String @id @default(cuid())

  contractRevisionId String?           @unique
  contractRevision   ContractRevision? @relation(fields: [contractRevisionId], references: [id], onDelete: Cascade)

  amendmentId String?    @unique
  amendment   Amendment? @relation(fields: [amendmentId], references: [id], onDelete: Cascade)

  signerId String
  signer   User   @relation(fields: [signerId], references: [id])

  /// The name as typed, kept verbatim — it is the signature.
  typedName String
  method    String  @default("TYPED")
  ip        String?
  userAgent String?

  /// The hash the signer actually attested to, copied at signing time. Kept
  /// here as well as on the revision so tampering is detectable from the
  /// signature alone. Null on a signature made before content hashing existed
  /// — back-dating one would be a claim nobody made.
  signedHash String?

  signedAt DateTime @default(now())
}

/// Every meaningful action, with actor and timestamp. Cheap to capture now and
/// expensive to reconstruct later; this is what the admin review-flagging queue
/// reads (v3 §5.4.6). The sequence of statuses alone won't say why a contract
/// bounced — the logged actions and their actors will.
enum ChangeAction {
  CREATED
  PUBLISHED
  CHOSE_CONCEPT
  APPROVED_PAGE
  UNAPPROVED_PAGE
  DESIGN_COMPLETE
  APPROVED_CONTRACT
  SIGNED
  COMMENTED
  SCOPE_ON
  SCOPE_OFF
  STATUS_CHANGED
  CONTRACT_REVISED
  DESIGN_REVISED
  CONTRACT_AMENDED
  RE_APPROVED
  RE_SIGNED
  AMENDMENT_SIGNED
  AMENDMENT_APPROVED
}

model ChangeLog {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  action ChangeAction
  /// The one variable part of the sentence — a concept key, a page label, a
  /// status. Rendered into the locale string on the client.
  arg    String?

  createdAt DateTime @default(now())

  @@index([contractId, createdAt])
  /// Serves the desk's global activity feed (V4 T2) — a query across every
  /// contract ordered by createdAt has nothing to use otherwise. An
  /// (action, createdAt) composite would not help: it filters `action IN
  /// (…)` and orders by time, which a leading-column-on-action index cannot
  /// answer in order.
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Billing & Support — modelled now, surfaced in a later phase
// ---------------------------------------------------------------------------

/// Build plan L6, spec §8: SUBSCRIPTION joins the original three — a
/// recurring charge generated by a Subscription rather than authored by hand
/// for a one-off contract milestone, service run, or billable ticket.
enum BillingSource {
  CONTRACT
  SERVICE
  TICKET
  SUBSCRIPTION
}

/// Record-keeping only — no payment gateway. Charges are created and marked
/// paid by Root. Separate from Hesab: this is purely "here is what you owe us".
///
/// Build plan L6 grows this from modelled-and-unsurfaced into four things:
/// the SUBSCRIPTION source above, the subscriptionId/periodStart/periodEnd
/// triple that a lazy generator writes (see lib/billing.ts), phaseId as the
/// milestone linkage (spec §8: "the portal shows what each payment is gated
/// on"), and ticketId as the billable-ticket edge L4 deliberately left
/// unbuilt (build plan L4's second banked trap).
model BillingEntry {
  id         String @id @default(cuid())
  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id])

  /// Build plan L6, spec §8's milestone linkage: the phase whose acceptance
  /// releases this payment. Reuses Phase.milestoneLabel — the free-text
  /// stand-in schema.prisma's own comment already named for "when L6 lands" —
  /// rather than inventing a separate Milestone model for the one fact it
  /// would hold (R1's own reasoning: a column, or here a model, that nothing
  /// yet needs beyond a label is a thing that acquires a wrong meaning before
  /// a right one). SetNull: a phase being restructured must not delete the
  /// charge history that pointed at it.
  phaseId String?
  phase   Phase?  @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  /// Build plan L6: which Subscription generated this entry, and which of
  /// its periods — set only for source SUBSCRIPTION, null for every entry
  /// authored by hand. Together with periodStart this is the backstop
  /// against the lazy generator's own worst failure mode (build plan L6's
  /// banked trap #1): the unique constraint below means two concurrent reads
  /// computing the same due period can never both insert, regardless of any
  /// race — the database refuses the second one, not a check-then-write in
  /// application code that a race could still slip past.
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  /// The period this entry bills for — its start is the natural key
  /// (@@unique below); periodEnd is carried alongside purely for display
  /// ("the period of ⟨start⟩–⟨end⟩"), never compared.
  periodStart    DateTime?
  periodEnd      DateTime?

  /// Build plan L4's second banked trap, built here: the edge from a ticket
  /// Root marked billable to the charge it produced. Unique — a ticket is
  /// billed once; a second charge for more work is a new ticket, not a
  /// second entry against the same one.
  ticketId String? @unique
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  /// Build plan L7's edge — the reverse side of ServiceRun.billingEntryId.
  serviceRun ServiceRun?

  source        BillingSource
  descriptionFa String
  descriptionEn String
  /// Toman. Integer — no float ever touches a charge (build plan L6's second
  /// banked trap; the predecessor plan's own §6.3 trap, arriving here again).
  amount        BigInt
  issuedAt      DateTime      @default(now())
  paidAt        DateTime?

  @@unique([subscriptionId, periodStart])
  @@index([customerId, paidAt])
}

/// Recurring charges the customer signs up to (build plan L6; spec §8) — SMS
/// API expense is the live case (spec §8: "the cheapest recurring probe").
/// Generates BillingEntry rows **lazily, on read** — lib/billing.ts's
/// `ensureSubscriptionEntries`, called wherever billing is opened. This is
/// build plan L6's first banked trap, decided rather than defaulted to: the
/// API is a plain Express process with no job runner, so "a cron-run
/// `npm run bill`" or "a real scheduler" are both real options, but both can
/// silently stop running — a systemd timer disabled during a deploy, a
/// scheduler process that dies quietly — and the failure is invisible until
/// someone notices an invoice never arrived. Lazy-on-read cannot stop running
/// this way: the next time anyone opens billing, the entries it should
/// already have exist. This row is only ever the *rule* that produces
/// entries; the entry itself stays the single charge record (spec §8).
model Subscription {
  id String @id @default(cuid())

  customerId String
  customer   User   @relation("SubscriptionCustomer", fields: [customerId], references: [id])

  /// Optional — the same nullable shape Ticket.projectId already uses (build
  /// plan L4's banked trap, applied here for the same reason): a subscription
  /// may track one engagement, or an ongoing customer relationship with no
  /// single project to name.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  labelFa String
  labelEn String

  /// Toman, per period. Integer — no float ever touches a charge. A
  /// metered/usage basis (spec §8's "amount or metered basis") is
  /// deliberately not built: no usage-tracking model exists anywhere in this
  /// schema (an SMS-send count, say), and inventing one to back a "metered"
  /// option nothing yet measures would be the same speculative-structure
  /// mistake this codebase's own precedents refuse elsewhere (L1's deferred
  /// Milestone model, L4's un-auto-generated ticket brief). A flat recurring
  /// amount is what SMS-as-the-probe (spec §8) actually needs; widen this to
  /// a metered basis when something in the system actually meters.
  amount BigInt

  period SubscriptionPeriod

  activeFrom  DateTime
  /// Null means ongoing. Ending a subscription (endSubscription) sets this
  /// rather than deleting the row — deleting would erase which periods were
  /// ever billed under it, the same "financial history is not deleted"
  /// reasoning BillingEntry itself is never given a delete mutation for.
  activeUntil DateTime?

  entries BillingEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([projectId])
}

enum SubscriptionPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

/// Build plan L4, spec §5: the three inbound channels are build feedback
/// (FeedbackItem), support (this model, as-built), and admin requests — a
/// type beside the original three, never a customer's own choice
/// (resolvers/tickets.ts refuses it on createTicket). ADMIN_REQUEST exists to
/// be *counted*: the count is the only input to the parked §10.2 decision on
/// whether site administration becomes a product, so it is queryable
/// (Query.adminRequestCount), not merely visible on one ticket at a time.
enum TicketType {
  CHANGE_REQUEST
  BUG
  QUESTION
  ADMIN_REQUEST
}

enum TicketUrgency {
  URGENT
  NOT_URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// Surfaced at L4 — modelled since the first migration, unreachable from the
/// API until now. `customerId` names who it belongs to; `projectId` (added at
/// L4) names which engagement, and only when there is one — a change ticket
/// derived from a demo belongs to a project, but a support ticket raised
/// after delivery may not (build plan L4's banked trap: both fields, kept
/// apart, decided here rather than inherited as one ambiguous edge).
model Ticket {
  id         String @id @default(cuid())
  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  /// Nullable on purpose (build plan L4) — see this model's own comment.
  /// SetNull: a project being archived or removed must not take its
  /// customer's support history down with it.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  type    TicketType
  urgency TicketUrgency @default(NOT_URGENT)
  status  TicketStatus  @default(OPEN)
  subject String

  /// Root marks a ticket billable for a major change request; that is what
  /// *would* create the Billing charge. The BillingEntry edge itself is
  /// designed and deliberately left unbuilt here (build plan L4's second
  /// banked trap) — it belongs with L6's billing work, and building it in
  /// both places means building it twice. This flag is only ever toggled by
  /// setTicketBillable; nothing reads it yet.
  billable Boolean @default(false)

  /// Build plan L4: "a ratified item becomes a change ticket — it is the
  /// brief." Set once, by createTicketFromFeedback, never again — a ticket
  /// converted from feedback has exactly one source, and a second conversion
  /// of the same item is refused (ALREADY_CONVERTED) rather than producing a
  /// second ticket for one piece of feedback.
  sourceFeedbackItemId String?       @unique
  sourceFeedbackItem   FeedbackItem? @relation(fields: [sourceFeedbackItemId], references: [id], onDelete: SetNull)

  /// The brief, snapshotted at conversion time — same reasoning as
  /// DemoFrameLine.textFa/textEn and Appendix 1 (build plan L1): a scope
  /// item's or frame line's label edited later must not silently rewrite
  /// what a past brief said. briefPageFa/En and briefAnnotation are compiled
  /// automatically from data already in hand (the target's own label, and
  /// the feedback thread verbatim); briefCurrentState/briefDesiredState are
  /// deliberately **not** auto-generated — see docs/development/L4.md for
  /// why synthesizing "what it looks like now vs. what it should look like"
  /// from a pile of comments would be inventing structure the raw data does
  /// not have, the same reasoning L3b applied to bilingual build notes.
  /// All five, or none — held by a CHECK (Ticket_brief_all_or_none), the same
  /// route this codebase's other "these columns agree" rules already take.
  briefPageFa       String?
  briefPageEn       String?
  /// The reviewer's own words, verbatim, oldest first — the annotation.
  briefAnnotation   String?
  /// Written by whoever performs the conversion — what the page shows today.
  briefCurrentState String?
  /// Written by whoever performs the conversion — what it should show instead.
  briefDesiredState String?
  /// Which language briefCurrentState/briefDesiredState were authored in
  /// ("fa"/"en") — the same noteLang shape BuildChangeEntry already uses, not
  /// a second required translation pair. Null exactly when they are.
  briefLang         String?

  messages TicketMessage[]

  /// Build plan L4's second banked trap, built at L6: the charge this
  /// billable ticket produced, if any. See BillingEntry.ticketId's own
  /// comment.
  billingEntry BillingEntry?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, status])
  @@index([projectId])
  @@index([type])
}

model TicketMessage {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])
  body     String

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// The dependency board (build plan L5; spec §7) — symmetric commitments,
// customer-side and Root-side, on one board under one rule. Overdue surfaces
// on both dashboards (Query.overdueDependencies for staff,
// Query.myOverdueDependencies for the customer). A Root-side row is the same
// object as a customer-side one — never a second model that could only nag
// the customer — because Root's own slippage (F5) is one of the frictions
// this exists to make visible.
// ---------------------------------------------------------------------------

/// Which party owes this commitment. Not a role, not a capability — a plain
/// tag on the row, since both sides live on the one board under the one rule.
enum DependencySide {
  CUSTOMER
  ROOT
}

/// One tracked commitment — owner (via side), a due date, and a verification
/// step. **Verification is the whole feature** (build plan L5's banked
/// trap): "they said we have a host" is what failed at the engagement this is
/// drawn from; "we deployed a test file to the host" is what verifiedNote
/// exists to hold. verifiedAt with no recorded *how* would rebuild the very
/// promise this replaces, so the two are held together — see the CHECK
/// (Dependency_verified_both_or_neither) and lib/dependency.ts.
model Dependency {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  side    DependencySide
  titleFa String
  titleEn String

  dueAt DateTime

  createdById String
  createdBy   User     @relation("DependencyCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  /// Null means unverified — "overdue" (lib/dependency.ts's isOverdue) is
  /// purely dueAt < now() AND verifiedAt IS NULL, derived fresh on every
  /// read, never a stored flag (the same F5 discipline ProjectProgress
  /// already holds to).
  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?     @relation("DependencyVerifiedBy", fields: [verifiedById], references: [id])
  /// What was actually done to verify it — required together with
  /// verifiedAt/verifiedById, never on its own. This field *is* the banked
  /// trap's fix: a timestamp with no note here would be exactly "they said,"
  /// dressed up as though it were checked.
  verifiedNote String?

  @@index([projectId, dueAt])
}

// ---------------------------------------------------------------------------
// Services — the product-import panel (build plan L7, 2026-09-21; spec §9).
// The first occupant of the portal's `services` stub, and the first of a
// class: "a service = a panel + a run history + a billing edge." Upload ->
// validate -> preview diff -> explicit apply -> run history — see
// lib/serviceImport.ts for the diff/validation rules and, critically, for
// why R1's Persian fold is used here only as a *comparison key*, never to
// transform stored text.
// ---------------------------------------------------------------------------

enum ServiceRunStatus {
  /// A file has been attached; nothing has been read from it yet.
  UPLOADED
  /// Parsed, validated, diffed against the store — previewServiceRun's own
  /// write. This is the gate: applyServiceRun refuses (NOT_PREVIEWED) from
  /// any other status. "The preview diff IS the feature" (L7's banked
  /// trap) — there is no path from UPLOADED to APPLIED that skips this.
  PREVIEWED
  /// Committed — this run's rows are now "the store" the next run diffs
  /// against (lib/serviceImport.ts's own comment on what "the store" means
  /// here, absent a live target-system integration).
  APPLIED
  /// The file could not be read or validated at all (a missing required
  /// column, an unreadable workbook) — never partially previewed.
  FAILED
}

enum ServiceRowAction {
  CREATE
  UPDATE
  /// Present in the upload and identical to the last applied run's own row
  /// — counted, not silently dropped, so the summary accounts for every row.
  UNCHANGED
  REJECTED
}

/// One upload's audit trail (spec §9: "each run is auditable... and
/// chargeable"), from the file landing to (maybe) being applied. A run
/// always exists once a file is attached, whether or not it is ever
/// previewed or applied — a run that failed to parse is still a row in the
/// history, not a silently discarded attempt.
model ServiceRun {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// The uploaded spreadsheet, kept for audit (spec §9: "file kept via
  /// StoredFile"). Restrict: a run's own record of what was uploaded must
  /// not be deletable out from under it.
  fileId String     @unique
  file   StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)

  uploadedById String
  uploadedBy   User     @relation("ServiceRunUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  status        ServiceRunStatus @default(UPLOADED)
  /// Required exactly when status is FAILED — CHECK below
  /// (`ServiceRun_failure_reason_required`), the same "declined-because"
  /// shape L3b's `Build` outcome already takes for DECLINED.
  failureReason String?

  previewedAt DateTime?

  appliedAt   DateTime?
  appliedById String?
  appliedBy   User?     @relation("ServiceRunAppliedBy", fields: [appliedById], references: [id])

  /// Build plan L6's edge, built here: the charge this run produced, if
  /// any. Never auto-created at apply time — a human decides whether and
  /// how much to bill, the same "created and marked paid by Root" shape
  /// every other BillingEntry source already has.
  billingEntryId String?       @unique
  billingEntry   BillingEntry? @relation(fields: [billingEntryId], references: [id], onDelete: SetNull)

  rows ServiceRunRow[]

  @@index([projectId, createdAt])
}

/// One parsed row of an import, kept whether or not the run is ever applied
/// — spec §9: "rejected rows with reasons" are part of the permanent
/// record, not a transient validation message. `raw` is the row exactly as
/// the sheet held it; `sku`/`nameFa`/`nameEn` are read from `raw` and stored
/// **verbatim, trimmed only** — never through `foldPersian` — see
/// lib/serviceImport.ts's own top comment for why folding the stored text
/// would corrupt the catalogue rather than merely miss a search hit.
model ServiceRunRow {
  id    String     @id @default(cuid())
  runId String
  run   ServiceRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// 1-based position in the sheet, for error messages ("row 14: ...").
  rowNumber Int

  /// The comparison key `lib/serviceImport.ts`'s diff matches on (folded,
  /// never stored folded) — but the value stored here is the customer's own
  /// text, untouched, because a SKU is read back by the same customer who
  /// typed it.
  sku    String
  nameFa String
  nameEn String?
  /// Toman. Integer — the same no-float rule every other charge in this
  /// schema holds to, even though a product price is not itself a
  /// BillingEntry. Null on a REJECTED row whose price could not be parsed.
  price  BigInt?
  stock  Int?

  action       ServiceRowAction
  /// Required exactly when action is REJECTED — CHECK below
  /// (`ServiceRunRow_reject_reason_required`).
  rejectReason String?

  /// The row exactly as parsed from the sheet, before validation — the
  /// audit copy spec §9 asks every run to carry, independent of whatever
  /// this row's own typed columns above were successfully read as.
  raw Json

  @@index([runId, rowNumber])
}

// ---------------------------------------------------------------------------
// Library — the Research Lab's corpus (R1)
// ---------------------------------------------------------------------------
//
// Bilingual as *data*, not as UI strings: a Persian title and an English title
// are both columns on the same row, present at once. This is the first model
// in the app where that is true — everywhere else, one locale is chosen per
// request and the other language lives in apps/web/src/i18n/locales/*.json.
//
// The rule that shapes this section (R1.md §1): a hosted file may exist only
// when the entry is PUBLIC and its rights basis is not LINK_ONLY. The two
// flags that each independently gate a hosted PDF being world-readable never
// meet in the spec, so the CHECK constraint below (hand-added to the
// migration — Prisma cannot express a cross-column rule as a `@@unique` or a
// `@default`) is the one place that closes both roads at once.

enum EntryType {
  PAPER // peer-reviewed
  BOOK
  ARTICLE // article / web
  ROOT_RESEARCH // Root's own — "distinct: grown here"
}

enum TranslationProvenance {
  PUBLISHED // an existing translation; cite translator + edition
  ROOT // Root translated it; labelled as such
  NONE_YET // original only; a reader may request one
}

enum RightsBasis {
  PUBLIC_DOMAIN
  OPEN_LICENCE
  PERMISSION_GRANTED
  LINK_ONLY
}

enum EntryVisibility {
  PUBLIC
  PRIVATE
}

model LibraryEntry {
  id String @id @default(cuid())

  /// The public reader's URL segment (R2). Unique, immutable once published —
  /// a URL that has been handed out is not free to change (T4).
  slug String    @unique
  type EntryType

  // ---- the work, in its own language ----
  /// BCP-47-ish tag ("fa", "en", "de"). Deliberately NOT the app's Locale
  /// enum: the app has two UI languages, the corpus has as many source
  /// languages as it has sources, and conflating them caps the Library at
  /// two (T2).
  originalLang     String
  titleOriginal    String
  /// Free text, as written on the paper. Not a relation, not an array —
  /// author disambiguation is a research-data problem this stage is not
  /// solving.
  authors          String
  venue            String?
  year             Int?
  doi              String?
  sourceUrl        String?
  abstractOriginal String?

  // ---- the translation ----
  /// Required, no default (§2.1) — a defaulted value here would be omission
  /// with a friendly face; "always shown, never implied" only holds if
  /// omission is impossible.
  translationProvenance TranslationProvenance
  titleTranslated       String?
  abstractTranslated    String?
  /// Where the "published" state's credit goes: translator, edition, link.
  translationCredit     String?

  // ---- rights ----
  /// Required, no default (§2.1) — same reasoning as translationProvenance.
  rightsBasis RightsBasis
  /// OPEN_LICENCE records the licence URL; PERMISSION_GRANTED records where
  /// the yes is. Both optional in the schema, both prompted by the editor.
  rightsNote  String?

  // ---- the hosted text (§1.1: the edge lives here, not on StoredFile) ----
  fullTextFileId String?     @unique
  fullTextFile   StoredFile? @relation("EntryFullText", fields: [fullTextFileId], references: [id], onDelete: Restrict)

  /// PUBLIC by default (§2.1) — the Lab is a public library, so public is the
  /// honest default; the private register is protected by publishedAt being
  /// null until someone publishes deliberately, not by this flag.
  visibility  EntryVisibility @default(PUBLIC)
  /// Null means draft. Set by publishLibraryEntry, which needs library.publish.
  publishedAt DateTime?

  /// Normalized haystack, maintained on write by buildSearchText — see
  /// lib/library.ts and T8. Folded through library_fold() so Persian
  /// orthographic variants compare equal (§5).
  searchText String @default("")

  concepts LibraryEntryConcept[]

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publishedAt, visibility])
  @@index([type])
}

/// Flat in R1 — no parentId. R3 owns the tree; a nullable self-relation with
/// no backfill is genuinely free to add later, and a column nothing reads
/// yet is a column that acquires a wrong meaning before a right one (§2.3).
model LibraryConcept {
  id      String @id @default(cuid())
  slug    String @unique
  titleFa String
  titleEn String

  entries LibraryEntryConcept[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Explicit join model rather than an implicit m-n: R3 will want ordering and
/// possibly a "primary concept", and an implicit relation cannot grow columns
/// later without becoming this model anyway (§2.3).
model LibraryEntryConcept {
  entryId   String
  conceptId String
  entry     LibraryEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  concept   LibraryConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([entryId, conceptId])
  @@index([conceptId])
}

// ---------------------------------------------------------------------------
// Review Room (C1) — a round is a frozen sha + allowlist + snapshots. Nothing
// about a round changes after publish; there is no ReviewGrant model on
// purpose (C1.md §1) — one corpus, for everyone holding review.participate,
// not per-reviewer visibility.
// ---------------------------------------------------------------------------

model ReviewRound {
  id String @id @default(cuid())

  /// The root-sot commit this round froze. Recorded, never fetched — the API
  /// never reads a git tree (C1.md §0).
  sha   String
  label String?

  publishedAt   DateTime @default(now())
  publishedById String
  publishedBy   User     @relation(fields: [publishedById], references: [id])

  documents ReviewDocument[]

  @@index([publishedAt])
}

model ReviewDocument {
  id      String      @id @default(cuid())
  roundId String
  round   ReviewRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  /// Path within root-sot, exactly as the manifest named it at that sha.
  path  String
  title String

  /// sha256 over the canonical serialization of `blocks` — see lib/revision.ts
  /// (buildDocumentSnapshot) and C1.md §2.1. Always recomputed server-side,
  /// never taken from the publish request.
  contentHash String

  /// The frozen document, as an ordered block list — see C1.md §2. This shape,
  /// not rendered HTML and not one raw string, is what lets a future comment
  /// anchor to (blockId, start, end) without re-publishing the round.
  blocks Json

  /// Position in the manifest, so the reading order matches what Root curated.
  order Int

  threads ReviewThread[]

  @@unique([roundId, path])
  @@index([roundId, order])
}

// ---------------------------------------------------------------------------
// Review Room — comments (C2). A comment anchors to a character range in one
// block's *rendered plain text*, not its markdown source (C2.md §1) — the
// string a reviewer actually selected. Offsets are local to one block, never
// global to the document (§1.2), which is why C1 split into blocks at all.
// ---------------------------------------------------------------------------

model ReviewThread {
  id         String         @id @default(cuid())
  documentId String
  document   ReviewDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// The reviewer who opened it. This is the ownership edge that keeps
  /// parallel review parallel — see lib/capabilities.ts's threadsVisibleTo.
  authorId String
  author   User   @relation("ThreadAuthor", fields: [authorId], references: [id])

  blockId     String
  /// Enforced by a hand-written CHECK in the migration: startOffset >= 0 AND
  /// endOffset > startOffset. A zero-width or inverted range is not a
  /// passage (C2.md §2).
  startOffset Int
  endOffset   Int
  /// The anchor's own witness (§1.1) — exactly the text the reviewer
  /// selected. Verified against the rendered block on every read; a
  /// mismatch (a dependency bump shifting the render) detaches the thread
  /// rather than re-finding it.
  quote       String

  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("ThreadResolver", fields: [resolvedById], references: [id])

  createdAt DateTime        @default(now())
  comments  ReviewComment[]

  @@index([documentId, authorId])
}

model ReviewComment {
  id       String       @id @default(cuid())
  threadId String
  thread   ReviewThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId String
  author   User         @relation(fields: [authorId], references: [id])
  body     String

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}
