{
  "name": "@root/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -b --noEmit",
    "test": "tsx --test src/lib/*.test.ts",
    "test:integration": "DATABASE_URL=\"postgresql://root:root@localhost:5432/root_website_test?schema=public\" STORAGE_DIR=\"${TMPDIR:-/tmp}/root-api-test-storage\" RESEND_API_KEY=\"\" MAIL_FROM=\"\" tsx --test --test-concurrency=1 src/test/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "backfill": "tsx prisma/backfill-revisions.ts",
    "create-admin": "tsx prisma/create-admin.ts",
    "publish-round": "tsx prisma/publish-round.ts",
    "start:e2e": "tsx src/index.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.116.0",
    "@apollo/server": "^4.11.0",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "graphql": "^16.9.0",
    "graphql-scalars": "^1.23.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.4",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
