# Copy to .env and fill in. Nothing here has a safe default.

NODE_ENV=development
PORT=4000

# Postgres (decided in the v3 overview §3). docker-compose.yml at the repo root
# brings up a matching local instance.
DATABASE_URL="postgresql://root:root@localhost:5432/root_website?schema=public"

# Session signing key — at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Where the customer-facing app lives. Invite and reset links point here.
APP_ORIGIN=http://localhost:5173

# Reverse proxies in front of this process. 0 in development — nothing is.
# Getting this wrong makes req.ip a proxy address, and req.ip is recorded on
# every signature.
TRUST_PROXY_HOPS=0

COOKIE_NAME=root_session
SESSION_DAYS=14
INVITE_DAYS=14
RESET_HOURS=2

# Where uploaded files are written. Left unset in development, where it
# defaults to apps/api/storage — a path that is in .gitignore and that nothing
# swaps out from under you. **In production it has no default and the process
# refuses to boot without it**, because the release script replaces the app
# directory on every deploy and a relative path would put customers' design
# files somewhere the next release deletes. See deploy/README.md.
# STORAGE_DIR=/srv/root/storage

# Public origin for the `public/` class, which Nginx serves straight off disk.
# Defaults to APP_ORIGIN + /public-files. Private files are never addressable
# this way — they go through GET /files/:id, which checks who is asking.
# PUBLIC_FILES_BASE=https://example.com/public-files
