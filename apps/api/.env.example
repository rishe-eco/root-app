# Copy to .env and fill in. Nothing here has a safe default.

NODE_ENV=development
PORT=4000

# Postgres (decided in the v3 overview §3). docker-compose.yml at the repo root
# brings up a matching local instance.
DATABASE_URL="postgresql://root:root@localhost:5432/root_website?schema=public"

# Session signing key — at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Where the customer-facing app lives. Invite and reset links point here.
APP_ORIGIN=http://localhost:5173

# Reverse proxies in front of this process. 0 in development — nothing is.
# Getting this wrong makes req.ip a proxy address, and req.ip is recorded on
# every signature.
TRUST_PROXY_HOPS=0

COOKIE_NAME=root_session

# Where uploaded mockups are served (journeys build plan J9): a view is
# http://<grant-id>.mockup.localhost:<PORT>/ — every browser resolves *.localhost
# to loopback, so this needs no hosts-file entry. Leave it as is in development.
MOCKUP_BASE_DOMAIN=mockup.localhost
SESSION_DAYS=14
INVITE_DAYS=14
RESET_HOURS=2

# Days from an invoice's issue to its due day, where nothing else says (the
# subscription generator's invoices; a draft with no term). A placeholder until
# the founder sets it. Planned invoices carry their own term.
DEFAULT_PAYMENT_TERM_DAYS=7

# Where uploaded files are written. Left unset in development, where it
# defaults to apps/api/storage — a path that is in .gitignore and that nothing
# swaps out from under you. **In production it has no default and the process
# refuses to boot without it**, because the release script replaces the app
# directory on every deploy and a relative path would put customers' design
# files somewhere the next release deletes. See deploy/README.md.
# STORAGE_DIR=/srv/root/storage

# Public origin for the `public/` class, which Nginx serves straight off disk.
# Defaults to APP_ORIGIN + /public-files. Private files are never addressable
# this way — they go through GET /files/:id, which checks who is asking.
# PUBLIC_FILES_BASE=https://example.com/public-files

# Outbound email (the "email seam", lib/mail.ts). Optional in every
# environment: unset means invite and reset links are logged to the console
# instead of sent, which is all development needs and a legitimate choice in
# production too, until a provider is wired. Setting only one of the two
# below is treated as a mistake, not a partial config, and the API refuses to
# boot.
#
# Get these from https://resend.com after verifying a sending domain there
# (Resend gives you DNS records — SPF/DKIM — to add wherever that domain's
# DNS is hosted; verification flips once they propagate). RESEND_API_KEY is
# created under API Keys. MAIL_FROM must be an address on that verified
# domain, e.g. "Root <hello@yourdomain.com>".
# RESEND_API_KEY=
# MAIL_FROM=

# The SMS provider (journeys build plan J1). Deliberately left empty on
# purpose (P0-4) — the founder has not chosen a provider yet. Development
# always sends through DevSmsTransport regardless of these, which logs
# codes to this console instead — see lib/sms.ts. Setting SMS_PROVIDER
# without SMS_API_KEY and SMS_SENDER is refused at boot; SMS_CODE_PATTERN
# and SMS_INVITE_PATTERN are needed only if the chosen provider requires a
# pre-approved template (see lib/smsProvider.ts).
# SMS_PROVIDER=
# SMS_API_KEY=
# SMS_SENDER=
# SMS_CODE_PATTERN=
# SMS_INVITE_PATTERN=
