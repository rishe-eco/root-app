# Copy to .env and fill in. Nothing here has a safe default.

NODE_ENV=development
PORT=4000

# Postgres (decided in the v3 overview §3). docker-compose.yml at the repo root
# brings up a matching local instance.
DATABASE_URL="postgresql://root:root@localhost:5432/root_website?schema=public"

# Session signing key — at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Where the customer-facing app lives. Invite and reset links point here.
APP_ORIGIN=http://localhost:5173

COOKIE_NAME=root_session
SESSION_DAYS=14
INVITE_DAYS=14
RESET_HOURS=2
