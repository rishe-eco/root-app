# Copy to .env at the repo root — docker compose reads that file, and only
# that one. This is NOT apps/api/.env, which is for running the API on the host
# in development; the two do not see each other.
#
#   cp .env.production.example .env
#
# .env is gitignored. Nothing below has a safe default.

# --- Postgres ---------------------------------------------------------------
# Used to build DATABASE_URL in docker-compose.prod.yml. Changing the password
# after the volume is initialized does not change the password inside Postgres
# — that is set once, when the data directory is created.
POSTGRES_USER=root
POSTGRES_PASSWORD=
POSTGRES_DB=root_website

# --- API --------------------------------------------------------------------
# Session signing key, 32 characters minimum. The API refuses to boot without
# it, on purpose. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# The public origin, scheme included, no trailing slash. Invite and password
# reset links are built from this, so a wrong value emails people dead links.
APP_ORIGIN=https://example.com

# How many reverse proxies sit in front of the API. Express counts hops back
# from the socket, so an undercount makes req.ip a proxy's address — and req.ip
# is written to Signature.ip on a legal signing record. 1 = host Nginx, which
# is the whole chain in this topology. Raise it only if you put something else
# in front (a CDN, a second proxy).
TRUST_PROXY_HOPS=1

COOKIE_NAME=root_session
SESSION_DAYS=14
INVITE_DAYS=14
RESET_HOURS=2

# --- Files ------------------------------------------------------------------
# Where uploads live, on the host. Bind-mounted into the API container at the
# same path, and read directly by host Nginx for the public class — so the two
# must agree with deploy/nginx/root.conf.
#
# It must sit OUTSIDE /srv/root/current. That symlink is swapped on every
# release and old releases are eventually pruned; a storage directory inside it
# would take every customer's design files with it. The API refuses to start in
# production without this set, precisely so the mistake cannot be made quietly.
STORAGE_DIR=/srv/root/storage

# Where the public class is reachable from a browser. Must match the
# `location /public-files/` block in deploy/nginx/root.conf.
PUBLIC_FILES_BASE=https://example.com/public-files

# --- Host binding -----------------------------------------------------------
# Where the API is published, on loopback only — host Nginx proxies to it and
# terminates TLS. Change it only if something else on the box already has 4000;
# deploy/nginx/root.conf must be changed to match.
API_PORT=4000

# --- Outbound email -----------------------------------------------------
# Optional, and safe to leave blank: unset means invite and reset links are
# logged instead of sent, same as in development. Get these from
# https://resend.com after verifying a sending domain there. Setting only one
# of the two is treated as a mistake, not a partial config, and the API
# refuses to boot.
RESEND_API_KEY=
MAIL_FROM=
